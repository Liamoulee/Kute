+#elif BUILDFLAG(IS_LINUX)
+// target_fps of SharedState in Kute's render-dll (shared.rs), third u64.
+constexpr size_t kKuteTargetFpsOffset = 16;
+
+// POSIX shared memory "/<name>", created by the host before the GPU process
+// starts (no sandbox). Missing means no limit. Mapped once, never unmapped.
+const std::atomic<uint64_t>* KuteTargetFpsField() {
+  static const std::atomic<uint64_t>* field = [] {
+    auto env = base::Environment::Create();
+    std::string name = "/" + env->GetVar("KUTE_TIMING_MAPPING")
+                                 .value_or(std::string("KuteFrameTiming"));
+    int fd = ::shm_open(name.c_str(), O_RDONLY, 0);
+    if (fd < 0) {
+      return static_cast<const std::atomic<uint64_t>*>(nullptr);
+    }
+    void* view = ::mmap(nullptr, kKuteTargetFpsOffset + sizeof(uint64_t),
+                        PROT_READ, MAP_SHARED, fd, 0);
+    ::close(fd);
+    if (view == MAP_FAILED) {
+      return static_cast<const std::atomic<uint64_t>*>(nullptr);
+    }
+    return reinterpret_cast<const std::atomic<uint64_t>*>(
+        static_cast<char*>(view) + kKuteTargetFpsOffset);
+  }();
+  return field;
+}
 #endif
 
