+void Display::KuteHoldAcks(std::vector<SurfaceId> surfaces,
+                           base::TimeDelta interval) {
+#if BUILDFLAG(IS_WIN)
+  base::TimeTicks now = base::TimeTicks::Now();
+  base::TimeTicks deadline = kute_next_deadline_ + interval;
+  // anchored to the previous deadline so a late wake does not add up; after
+  // a pause or on the first frame the schedule restarts from now
+  if (kute_next_deadline_.is_null() || deadline < now - interval) {
+    deadline = now;
+  }
+  kute_next_deadline_ = deadline;
+  kute_held_acks_.emplace_back(deadline, std::move(surfaces));
+  // a running timer serves an older deadline first and re-arms itself
+  if (!kute_release_timer_.IsRunning()) {
+    KuteArmRelease();
+  }
+#else
+  damage_tracker_->RunDrawCallbacks();
+#endif
+}
+
+// Delayed tasks wake at whole milliseconds: all but the last two go through
+// one, the rest waits on the high resolution timer in KuteReleaseAcks.
+void Display::KuteArmRelease() {
+#if BUILDFLAG(IS_WIN)
+  if (kute_held_acks_.empty()) {
+    return;
+  }
+  base::TimeTicks deadline = kute_held_acks_.front().first;
+  kute_release_timer_.SetTaskRunner(current_task_runner_);
+  kute_release_timer_.Start(
+      FROM_HERE, deadline - base::Milliseconds(2),
+      base::BindOnce(&Display::KuteReleaseAcks, base::Unretained(this),
+                     deadline),
+      base::subtle::DelayPolicy::kPrecise);
+#endif
+}
+
+// Waits out the rest of the interval on the high resolution timer (the thread
+// sleeps, no spin), then acks every frame held for this deadline or earlier.
+void Display::KuteReleaseAcks(base::TimeTicks up_to) {
+#if BUILDFLAG(IS_WIN)
+  base::TimeDelta remaining = up_to - base::TimeTicks::Now();
+  if (remaining.is_positive()) {
+    if (!kute_timer_) {
+      kute_timer_ = ::CreateWaitableTimerExW(
+          nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+          TIMER_ALL_ACCESS);
+    }
+    if (kute_timer_) {
+      LARGE_INTEGER due;
+      due.QuadPart = -(remaining.InNanoseconds() / 100);
+      if (::SetWaitableTimer(kute_timer_, &due, 0, nullptr, nullptr, FALSE)) {
+        ::WaitForSingleObject(kute_timer_, INFINITE);
+      }
+    }
+  }
+  while (!kute_held_acks_.empty() && kute_held_acks_.front().first <= up_to) {
+    std::vector<SurfaceId> surfaces = std::move(kute_held_acks_.front().second);
+    kute_held_acks_.pop_front();
+    for (const auto& surface_id : surfaces) {
+      if (Surface* surface = surface_manager_->GetSurfaceForId(surface_id)) {
+        surface->SendAckToClient();
+      }
+    }
+  }
+  KuteArmRelease();
+#endif
+}
+
+void Display::KuteReleaseAllAcks() {
+#if BUILDFLAG(IS_WIN)
+  kute_release_timer_.Stop();
+#endif
+  if (!kute_held_acks_.empty()) {
+    KuteReleaseAcks(base::TimeTicks::Max());
+  }
+}
