+// One held ack per deadline. The schedule is anchored to the previous deadline
+// so a late wake does not add up; after a pause, on the first frame, or once
+// the limit is lifted it restarts from now.
+void DisplayScheduler::KuteArmRelease() {
+#if BUILDFLAG(IS_WIN)
+  base::TimeDelta interval = KuteLimitInterval();
+  base::TimeTicks now = base::TimeTicks::Now();
+  base::TimeTicks deadline = kute_next_deadline_ + interval;
+  if (interval.is_zero() || kute_next_deadline_.is_null() ||
+      deadline < now - interval) {
+    deadline = now;
+  }
+  kute_release_timer_.SetTaskRunner(task_runner_.get());
+  kute_release_timer_.Start(
+      FROM_HERE, deadline - base::Milliseconds(2),
+      base::BindOnce(&DisplayScheduler::KuteReleaseSwapAck,
+                     base::Unretained(this), deadline),
+      base::subtle::DelayPolicy::kPrecise);
+#else
+  KuteReleaseSwapAck(base::TimeTicks());
+#endif
+}
+
+// Waits out the rest of the interval on the high resolution timer (the thread
+// sleeps, no spin), then lets the scheduler see the swap ack.
+void DisplayScheduler::KuteReleaseSwapAck(base::TimeTicks deadline) {
+#if BUILDFLAG(IS_WIN)
+  base::TimeDelta remaining = deadline - base::TimeTicks::Now();
+  if (remaining.is_positive()) {
+    if (!kute_timer_) {
+      kute_timer_ = ::CreateWaitableTimerExW(
+          nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION,
+          TIMER_ALL_ACCESS);
+    }
+    if (kute_timer_) {
+      LARGE_INTEGER due;
+      due.QuadPart = -(remaining.InNanoseconds() / 100);
+      if (::SetWaitableTimer(kute_timer_, &due, 0, nullptr, nullptr, FALSE)) {
+        ::WaitForSingleObject(kute_timer_, INFINITE);
+      }
+    }
+  }
+#endif
+  kute_next_deadline_ = deadline;
+  if (kute_held_swap_acks_ > 0) {
+    kute_held_swap_acks_--;
+    KuteFinishSwapAck();
+  }
+  if (kute_held_swap_acks_ > 0) {
+    KuteArmRelease();
+  }
+}
