 namespace viz {
 
+// Kute: frame production limiter. With --disable-frame-rate-limit a cap had
+// to be held somewhere: the DXGI hook waited on the present thread (a 1 ms
+// spin per frame, the whole wait at 500 fps) and without the hook the bundle
+// busy waited on the game's main thread (other tasks up to 11 ms late). With
+// this feature the Display draws and presents a frame right away as usual but
+// holds the surface acks of that frame until the next deadline of the
+// interval the host writes into its KuteFrameTiming mapping (target_fps,
+// live). The renderer waits for that ack before its next frame
+// (KuteFramePacing), so frames start on the grid and reach the screen as soon
+// as they are drawn, like with the hook's limiter, and nothing spins: a
+// delayed task covers all but the last two milliseconds, a high resolution
+// waitable timer the rest. Enabled by Kute with
+// --enable-features=KuteFrameLimiter.
+BASE_FEATURE(kKuteFrameLimiter,
+             "KuteFrameLimiter",
+             base::FEATURE_DISABLED_BY_DEFAULT);
+
 namespace {
 
+#if BUILDFLAG(IS_WIN)
+// target_fps of SharedState in Kute's render-dll (shared.rs), third u64.
+constexpr size_t kKuteTargetFpsOffset = 16;
+
+// The mapping is created by the host before the GPU process starts. Missing
+// means no limit. Opened once, never closed, the process owns it for life.
+const std::atomic<uint64_t>* KuteTargetFpsField() {
+  static const std::atomic<uint64_t>* field = [] {
+    auto env = base::Environment::Create();
+    std::string name = env->GetVar("KUTE_TIMING_MAPPING")
+                           .value_or(std::string("KuteFrameTiming"));
+    HANDLE mapping =
+        ::OpenFileMappingW(FILE_MAP_READ, FALSE, base::UTF8ToWide(name).c_str());
+    if (!mapping) {
+      return static_cast<const std::atomic<uint64_t>*>(nullptr);
+    }
+    void* view = ::MapViewOfFile(mapping, FILE_MAP_READ, 0, 0, 0);
+    if (!view) {
+      return static_cast<const std::atomic<uint64_t>*>(nullptr);
+    }
+    return reinterpret_cast<const std::atomic<uint64_t>*>(
+        static_cast<char*>(view) + kKuteTargetFpsOffset);
+  }();
+  return field;
+}
+#endif
+
+base::TimeDelta KuteLimitInterval() {
+#if BUILDFLAG(IS_WIN)
+  static const bool enabled = base::FeatureList::IsEnabled(kKuteFrameLimiter);
+  if (!enabled) {
+    return base::TimeDelta();
+  }
+  const std::atomic<uint64_t>* field = KuteTargetFpsField();
+  if (!field) {
+    return base::TimeDelta();
+  }
+  uint64_t fps = field->load(std::memory_order_relaxed);
+  if (fps == 0) {
+    return base::TimeDelta();
+  }
+  return base::Nanoseconds(1000000000 / fps);
+#else
+  return base::TimeDelta();
+#endif
+}
