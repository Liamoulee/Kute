+// (3 quanta of 128 frames at 48 kHz is every 8 ms) keeps that cost down. 1 re-pans in every quantum.
+constexpr base::FeatureParam<int> kKuteAudioPannerQuanta{&kKuteAudioPannerPerQuantum, "quanta", 3};
