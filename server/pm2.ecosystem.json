{
    "apps": [
        {
            "_comment": "plain process: pm2's bun mode require()s the script, which breaks on top level await",
            "name": "kute-server",
            "cwd": ".",
            "script": "bun",
            "args": ["run", "src/server.ts"],
            "interpreter": "none",
            "autorestart": true,
            "max_restarts": 10,
            "restart_delay": 2000,
            "env": {
                "NODE_ENV": "production"
            }
        }
    ]
}
